# Copy this file to `~/.config/catus/config.toml` (the XDG base config) or to
# `./.sutcac/config.toml` (the workspace config, merged on top of the XDG one
# with workspace values winning) and fill in your OpenAI-compatible API key.

# API vendor endpoints. Each provider names its base URL and API key.
# `session_header` is optional: when set, every request carries one stable
# session ID per conversation under that header name (e.g. the opencode
# platform requires `x-opencode-session`). Omit it for providers that do
# not need such a header.
[[providers]]
name = "opencode"
base_url = "https://api.opencode.example.com/v1"
api_key = "sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
session_header = "x-opencode-session"

[[providers]]
name = "openai"
base_url = "https://api.openai.com/v1"
api_key = "sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Configured models. `provider` references a [[providers]] entry by name.
# `name` is shown in the UI (falls back to `id`); `context_window` is the
# model's context size in tokens (0/omitted = unknown) and also accepts
# human-readable strings like "512k", "1M", "0.5m" (1024-based suffixes,
# case-insensitive; a trailing `b` is ignored). Switch between configured
# models at runtime with `/model`.
[[models]]
id = "kimi-k2"
name = "Kimi K2"
context_window = "128k"
provider = "opencode"

[[models]]
id = "gpt-4o-mini"
name = "GPT-4o mini"
context_window = 128000
provider = "openai"

[agent]
max_tool_rounds = 10
# Session history is always persisted at ~/.config/catus/history/sessions.db
# (one global database; sessions are listed per working directory) and can be
# loaded again with `/resume <name>`. Logs go to ~/.config/catus/catus.log and
# the shell audit trail to ~/.config/catus/audit.log — none are configurable.

# Optional log level: trace, debug, info, warn, error. Defaults to info.
# log_level = "info"

# Optional additional directories to scan for Agent Skills (directories
# containing skill subdirectories, each with a SKILL.md file). Defaults to
# ./.sutcac/skills/ and ~/.config/catus/skills/.
# skill_paths = ["~/.local/share/catus/skills"]

# Whether to append the list of discovered skills to the system prompt so the
# model knows they are available. Defaults to true.
# auto_include_skills = true

# Optional additional directories to scan for Agent definitions (Markdown files
# with YAML frontmatter). Defaults to ./.sutcac/agents/ and
# ~/.config/catus/agents/.
# agent_paths = ["~/.local/share/catus/agents"]

# Agent Memory subsystem. When enabled, catus dispatches the `memory`-role
# subagent before each user turn (recall: simple tasks skip memory, otherwise
# relevant memories are injected into the conversation) and after each turn
# (summarize: key facts are written into an mdbook store at the fixed path
# ~/.config/catus/memory, shared by all projects). The store is an mdbook
# project (book.toml + src/SUMMARY.md); `mdbook build` runs only when the
# mdbook binary is available. `memory.md` (role: memory) must exist in the
# agent search paths — catus installs a default into ~/.config/catus/agents/.
# [agent.memory]
# enabled = false
# auto_recall = true
# auto_write = true

# Model tiers for agent definitions. An agent's `model` frontmatter field
# accepts "performance" or "efficient" and maps to the model configured here
# (referenced by [[models]] id or display name). `performance` is required;
# `efficient` is optional and falls back to `performance` when omitted.
[agent.models]
performance = "kimi-k2"
# efficient = "gpt-4o-mini"

# Optional MCP client configuration. catus connects to the configured MCP
# servers at startup and exposes their tools to the LLM alongside the built-in
# `shell` tool. Two transports are supported: stdio child processes (default)
# and remote Streamable HTTP servers. Tool names are prefixed with
# `{server_name}__` to avoid collisions, e.g. `filesystem__read_file`.
# [[mcp.servers]]
# name = "filesystem"
# command = "npx"
# args = ["-y", "@modelcontextprotocol/server-filesystem", "/path/to/dir"]
#
# [mcp.servers.env]
# HOME = "/home/user"

# Example: local calculator MCP server built from this workspace.
# Tools are exposed as `calc__sum`, `calc__sub`, `calc__mul`, `calc__div`,
# and `calc__modulo`.
# [[mcp.servers]]
# name = "calc"
# command = "target/debug/mcp-calc-server"

# Example: remote MCP server over Streamable HTTP. `transport` defaults to
# "stdio"; `command` may be omitted for remote servers. `headers` are sent
# with every request (e.g. for Bearer authentication). The legacy SSE
# transport is not supported.
# [[mcp.servers]]
# name = "remote-calc"
# transport = "streamable-http"
# url = "https://mcp.example.com/calc"
#
# [mcp.servers.headers]
# Authorization = "Bearer sk-xxxxxxxx"

[shell]
# allow_all | allow:<tags> | deny:<tags> | allow:<tags> deny:<tags> | allow1:<cmds> | deny1:<cmds>
perm_mode = "allow_all"
# The audit trail is always written to ~/.config/catus/audit.log.
audit_format = "text"

# Shorthand permission lists: every listed command gets the READ (or WRITE)
# permission tag, equivalent to listing each one under [shell.commands].
# Only genuinely read-only commands belong here: awk/sed/sort/find/git/xargs
# and pagers can write files or run subcommands on their own, so they stay
# unlisted and fall back to the READ+WRITE default.
read = [
  "basename", "bc", "cat", "cmp", "comm", "cut", "date", "diff", "dirname",
  "df", "du", "env", "file", "grep", "head", "id", "ls", "md5sum", "nl",
  "od", "printf", "ps", "pwd", "readlink", "realpath", "seq", "sha256sum",
  "stat", "strings", "tac", "tail", "tr", "uniq", "wc", "whereis", "which",
  "xxd",
]

# Write commands usable out of the box: pure writers/creators/removers.
# Commands that also read a source (cp, mv, dd, ...) are listed under
# [shell.commands] below instead, since they need both tags.
write = [
  "chmod", "chown", "ln", "mkdir", "rm", "rmdir", "tee", "touch", "truncate",
]

# Shorthand for commands needing both tags: equivalent to
# `tags = ["read", "write"]` under [shell.commands]. Entries in
# [shell.commands] still take precedence.
# rw = ["cp", "mv", "dd"]

# Per-command permission tags. Any external command not listed here defaults
# to READ+WRITE. Entries here override the shorthand lists above.
[shell.commands]
# curl can write files (`-o`/`-O`), so it requires WRITE as well.
curl = ["network", "read", "write"]
# cp/mv/dd read a source and write a destination, so they need both tags.
cp = ["read", "write"]
mv = ["read", "write"]
dd = ["read", "write"]
clip = ["clipboard"]

# Optional path-based access control. Paths are canonicalized when the config
# is loaded; relative paths are resolved against the working directory at load
# time, not at command execution time.
#
# The current working directory (the workspace) is always readable and
# writable; every other directory is denied by default. Writable directories
# are implicitly readable. Extra directories can be granted per session via
# the `ask_permission` tool. To lift the restriction entirely, allow the root:
#   read_paths = ["/"]
#   write_paths = ["/"]
# read_paths = ["/home/user/data", "/tmp"]
# write_paths = ["/home/user/projects"]

# Optional structured metadata appended to every audit log entry.
[shell.audit_meta]
session = "example-session"
