# Copy this file to `.sutcac/config.toml` (or `~/.config/catus/config.toml`)
# and fill in your OpenAI-compatible API key.

[api]
base_url = "https://api.openai.com/v1"
api_key = "sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
model = "gpt-4o-mini"

[agent]
system_prompt = """You are a helpful assistant running inside a simplified Bash shell.
You can execute shell commands using the provided `shell` function.
Call it with a JSON object like {"command": "the command"}.
The user will see the command output and you can continue.
When you have enough information, answer the user directly without tools."""
max_tool_rounds = 10
# Optional directory for JSON conversation-history files. When set, catus can
# load a previous conversation with `/resume <name>` and saves the current
# session to a timestamped JSON file on exit.
history_path = ".sutcac/history"

# Optional log file path. All catus diagnostics are written here; nothing is
# printed to stderr while the TUI is running. Defaults to `.sutcac/catus.log`.
# log_path = ".sutcac/catus.log"

# Optional log level: trace, debug, info, warn, error. Defaults to info.
# log_level = "info"

# Optional additional directories to scan for Agent Skills (directories
# containing skill subdirectories, each with a SKILL.md file). Defaults to
# ./.sutcac/skills/ and ~/.config/catus/skills/.
# skill_paths = ["~/.local/share/catus/skills"]

# Whether to append the list of discovered skills to the system prompt so the
# model knows they are available. Defaults to true.
# auto_include_skills = true

# Optional MCP client configuration. catus connects to the configured MCP
# servers at startup and exposes their tools to the LLM alongside the built-in
# `shell` tool. Only stdio child-process servers are supported initially.
# Tool names are prefixed with `{server_name}__` to avoid collisions, e.g.
# `filesystem__read_file`.
# [[mcp.servers]]
# name = "filesystem"
# command = "npx"
# args = ["-y", "@modelcontextprotocol/server-filesystem", "/path/to/dir"]
#
# [mcp.servers.env]
# HOME = "/home/user"

# Example: local calculator MCP server built from this workspace.
# Tools are exposed as `calc__sum`, `calc__sub`, `calc__mul`, `calc__div`,
# and `calc__modulo`.
# [[mcp.servers]]
# name = "calc"
# command = "target/debug/mcp-calc-server"

[shell]
# allow_all | allow:<tags> | deny:<tags> | allow:<tags> deny:<tags> | allow1:<cmds> | deny1:<cmds>
perm_mode = "allow_all"
audit_log = "/tmp/sutcac-audit.log"
audit_format = "text"

# Optional structured metadata appended to every audit log entry.
[shell.audit_meta]
session = "example-session"

# Shorthand permission lists: every listed command gets the READ (or WRITE)
# permission tag, equivalent to listing each one under [shell.commands].
read = [
  "awk", "basename", "cat", "cmp", "comm", "cut", "diff", "dirname", "file",
  "find", "git", "grep", "head", "less", "ls", "more", "nl", "printf", "ps",
  "pwd", "readlink", "realpath", "sed", "sort", "strings", "tail", "tr",
  "uniq", "wc", "whereis", "which", "xargs",
]
# write = ["mkdir", "touch"]

# Per-command permission tags. Any external command not listed here defaults
# to READ+WRITE. Entries here override the shorthand lists above.
[shell.commands]
curl = ["network", "read"]
clip = ["clipboard"]

# Optional path-based access control. Paths are canonicalized when the config
# is loaded; relative paths are resolved against the working directory at load
# time, not at command execution time. Empty lists mean no restriction.
# read_paths = ["/home/user/data", "/tmp"]
# write_paths = ["/home/user/projects"]
